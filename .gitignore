# Raw session transcripts, mirrored by the Stop hook in .claude/settings.json.
#
# Deliberately NOT committed. Transcripts capture everything discussed, including
# material never intended as project documentation. The curated session entries in
# log/*.md are the versioned record; log/raw/ is a local safety net.
#
# See log/README.md.
log/raw/

# Personal Claude Code overrides
.claude/settings.local.json

# Local compose overrides. .env.example is the committed template.
.env

# A local worker's application config. kuwarden.yaml belongs to the *application's*
# repository, not to this one — here it is only ever a pointer at someone's test repo and
# organisation. kuwarden.example.yaml is the committed template.
kuwarden.yaml

# Python. uv.lock IS committed — this ships into air-gapped environments, where a
# non-reproducible resolve is not an inconvenience but a blocker.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Diagram rendering (docs/diagrams/render.mjs needs `npm i sharp`)
node_modules/
package-lock.json
docs/diagrams/package.json

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
