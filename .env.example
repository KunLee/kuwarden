# Copy to .env to override. Every value here is the default already baked into
# compose.yaml — an empty .env changes nothing.
#
# Development credentials only. Real deployments inject these from the
# platform's secret store; nothing in this file is ever a production value.

# --- Temporal ---------------------------------------------------------------
KUWARDEN_TEMPORAL_NAMESPACE=kuwarden
KUWARDEN_TEMPORAL_PORT=7233
KUWARDEN_TEMPORAL_UI_PORT=8233
KUWARDEN_TEMPORAL_LOG_LEVEL=warn

# --- PostgreSQL -------------------------------------------------------------
KUWARDEN_POSTGRES_USER=kuwarden
KUWARDEN_POSTGRES_PASSWORD=dev
KUWARDEN_POSTGRES_DB=kuwarden
KUWARDEN_POSTGRES_PORT=5432
