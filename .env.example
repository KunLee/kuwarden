# Copy to .env and fill in the required values. `.env` is gitignored.
#
# Everything with a value below is the default already baked into compose.yaml —
# uncomment only what you want to change. The required entries have no default
# anywhere, deliberately: a credential that works out of the box is a credential
# nobody replaces.

# --- Required ---------------------------------------------------------------
# Generate one rather than inventing one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
KUWARDEN_POSTGRES_PASSWORD=

# --- Temporal ---------------------------------------------------------------
# KUWARDEN_TEMPORAL_NAMESPACE=kuwarden
# KUWARDEN_TEMPORAL_PORT=7233
# KUWARDEN_TEMPORAL_UI_PORT=8233
# KUWARDEN_TEMPORAL_LOG_LEVEL=warn

# --- PostgreSQL -------------------------------------------------------------
# KUWARDEN_POSTGRES_USER=kuwarden
# KUWARDEN_POSTGRES_DB=kuwarden
# KUWARDEN_POSTGRES_PORT=5432
# KUWARDEN_POSTGRES_HOST=127.0.0.1
#
# Or supply the whole connection string, which wins over the parts above:
# KUWARDEN_DATABASE_URL=postgresql://user:password@host:5432/kuwarden

# --- Platform credentials ---------------------------------------------------
# Resolved by the credential broker at the point of use. They are never written
# to kuwarden.yaml, never carried on FlowState, and never present in a sandbox.
# A realm-scoped name wins over the bare one, so one process can serve two
# organisations without either being reachable for the other's resources:
#   KUWARDEN_SCM_TOKEN__GITHUB_COM_ACME=...
#
# KUWARDEN_TICKET_TOKEN=
# KUWARDEN_SCM_TOKEN=
# KUWARDEN_LLM_API_KEY=

# --- Approval notifications -------------------------------------------------
# Optional. With no relay configured the gate still works: the run suspends and
# the Workbench shows it, but nobody is told, so a run can sit for a day.
#
# The mail is a notification only — it carries a link and no ticket content, and
# a decision can be made only on the authenticated evidence page.
#
# Where a recipient's browser can reach the Workbench. Not derived from the
# request that started the run, which may have come through a proxy.
# KUWARDEN_BASE_URL=http://localhost:5173
#
# KUWARDEN_SMTP_HOST=
# KUWARDEN_SMTP_PORT=25
# KUWARDEN_SMTP_FROM=kuwarden@localhost
# KUWARDEN_SMTP_USER=
# KUWARDEN_SMTP_PASSWORD=
