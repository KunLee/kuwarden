{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/save-transcript.mjs\"",
            "shell": "bash",
            "async": true,
            "timeout": 15,
            "statusMessage": "Mirroring transcript to log/raw/"
          }
        ]
      }
    ]
  }
}
